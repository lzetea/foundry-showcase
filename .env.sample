# ============================================================
#  Foundry Control Plane — Agent Observability Demo
# ============================================================
#  1. Copy this file to .env:   cp .env.sample .env
#  2. Fill in the values below
#  3. The .env file is git-ignored
#
#  Auth: this demo uses Microsoft Entra ID (DefaultAzureCredential).
#        Run `az login` before running the scripts. No account keys
#        are required or stored.
# ============================================================


# ----------------------------------------------------------
#  AZURE_AI_PROJECT_ENDPOINT  (Required — All scripts)
# ----------------------------------------------------------
#  Full project endpoint URL for your Foundry project.
#  FORMAT: https://<account>.services.ai.azure.com/api/projects/<project>
#  FIND IT: Foundry Portal → Your Project → Overview → Project endpoint
# ----------------------------------------------------------
AZURE_AI_PROJECT_ENDPOINT=


# ----------------------------------------------------------
#  AZURE_AI_MODEL_DEPLOYMENT_NAME  (Required — All scripts)
# ----------------------------------------------------------
#  Name of the deployed model your agents will use.
#  RECOMMENDED: gpt-5 with ≥30K TPM quota.
# ----------------------------------------------------------
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-5


# ----------------------------------------------------------
#  TELEMETRY_CONNECTION_STRING  (Optional — Tracing scripts)
# ----------------------------------------------------------
#  Application Insights connection string.
#  Auto-discovered from the Foundry project if not set.
# ----------------------------------------------------------
TELEMETRY_CONNECTION_STRING=


# ----------------------------------------------------------
#  ACR_NAME  (Required — Hosted agent deployment only)
# ----------------------------------------------------------
#  Azure Container Registry name (without .azurecr.io).
#  Only needed for MAF and LangGraph agent deployment.
# ----------------------------------------------------------
ACR_NAME=


# ----------------------------------------------------------
#  Tracing settings
# ----------------------------------------------------------
#  Set to "true" ONLY in non-production / demo environments.
#  When enabled, full prompts and responses (which may contain PII)
#  are sent to Application Insights.
# ----------------------------------------------------------
AZURE_TRACING_GEN_AI_CONTENT_RECORDING_ENABLED=false
AZURE_LOG_LEVEL=error


# ============================================================
#  Compute layer (APIM AI Gateway + ACA) — scenarios 02 & 03
# ============================================================
#  All of the keys below are hydrated automatically by
#  `scripts/setup-env.ps1` from `azd env get-values` after
#  `azd up`. You only need to fill them in by hand if you are
#  pointing this demo at an existing deployment.
# ============================================================


# ----------------------------------------------------------
#  APIM_GATEWAY_URL  (Required — scenarios 02 & 03)
# ----------------------------------------------------------
#  Base URL of the APIM instance fronting the ACA agents.
#  Used to build `${APIM_GATEWAY_URL}/agents/<subroute>`.
#  FORMAT: https://<apim-name>.azure-api.net
# ----------------------------------------------------------
APIM_GATEWAY_URL=


# ----------------------------------------------------------
#  APIM_OPENAI_GATEWAY_URL  (Required — scenarios 02 & 03 deploy)
# ----------------------------------------------------------
#  APIM endpoint that ACA containers use as AZURE_OPENAI_ENDPOINT.
#  FORMAT: https://<apim-name>.azure-api.net/openai
# ----------------------------------------------------------
APIM_OPENAI_GATEWAY_URL=


# ----------------------------------------------------------
#  APIM_AGENTS_KEY_SECRET_NAME  (Required — scenarios 02 & 03)
# ----------------------------------------------------------
#  Name of the Key Vault secret holding the APIM `agents`
#  subscription key. Pulled at runtime by the Python clients.
# ----------------------------------------------------------
APIM_AGENTS_KEY_SECRET_NAME=


# ----------------------------------------------------------
#  APIM_OPENAI_KEY_SECRET_NAME  (Required — scenarios 02 & 03 deploy)
# ----------------------------------------------------------
#  Name of the Key Vault secret holding the APIM `openai`
#  subscription key. Mounted into ACA as AZURE_OPENAI_API_KEY.
# ----------------------------------------------------------
APIM_OPENAI_KEY_SECRET_NAME=


# ----------------------------------------------------------
#  KEYVAULT_URI  (Required — scenarios 02 & 03)
# ----------------------------------------------------------
#  Key Vault URI used to resolve the secret names above.
#  FORMAT: https://<kv-name>.vault.azure.net/
# ----------------------------------------------------------
KEYVAULT_URI=


# ----------------------------------------------------------
#  APIM_OPENAI_API_VERSION  (Optional)
# ----------------------------------------------------------
#  OpenAI API version forwarded by the ACA agents through the
#  `/openai` gateway. Defaults to 2024-10-21 if unset.
# ----------------------------------------------------------
APIM_OPENAI_API_VERSION=2024-10-21
