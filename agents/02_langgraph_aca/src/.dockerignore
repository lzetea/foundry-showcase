# Never ship secrets or local state into the image
.env
.env.*
*.pem
*.key

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# VCS / IDE / OS
.git/
.gitignore
.vscode/
.idea/
.DS_Store
Thumbs.db

# Docs / build artifacts
# NOTE: keep instructions/*.md — the agent loads its system prompt from there at runtime.
*.md
!instructions/
!instructions/*.md
dist/
build/
